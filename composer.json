{
    "name": "ticketpark/php-api-client",
    "description": "A PHP client to use the Ticketpark API",
    "type": "library",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ticketpark",
            "email": "tech@ticketpark.ch"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Ticketpark\\ApiClient\\": "lib/ApiClient",
            "Ticketpark\\ApiClient\\Test\\": "test/ApiClient"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^1.2 || ^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpspec/prophecy": "^1.20"
    }
}
